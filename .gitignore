# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Third-party source, fetched by scripts/bootstrap.py, never committed ---
# SUAVE is LGPL 2.1. It is fetched from its own repository so that this repo does not
# redistribute it and does not take on its license obligations.
vendor/SUAVE/

# --- nTop block universe, extracted locally by scripts/bootstrap.py ---
# These files are a bulk export of the nTop block and type universe. They come from an nTop
# install or build on the developer's own machine. They are NOT redistributed here: they are
# nTop's API surface, they include blocks that are not publicly released, and they are specific
# to one nTop version. Run scripts/bootstrap.py to produce them locally.
vendor/functions.json
vendor/types.json
vendor/type_defaults.json

# --- Generated run artefacts ---
# Everything under runs/ is regenerated by run_sv1.py. Only the curated reference example in
# examples/ is committed. Large CAD exports and notebook caches are never committed.
runs/
*.stl
*.step
*.stp
*.igs
*.iges
*.implicit
*.ntop
*.b8.ugrid

# The curated reference example IS committed, including its CAD and its nTop notebook. The
# notebook is the artefact an nTop user actually wants, so it is worth the space.
!examples/**
!examples/**/*.png
!examples/**/*.json
!examples/**/*.csv
!examples/**/*.pdf
!examples/**/*.stl
!examples/**/*.step
!examples/**/*.implicit
!examples/**/*.ntop

# --- Credentials and local configuration. Never commit these. ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
client_secret*.json
*oauth*.json
*-key.json
gcp-key.json
service-account*.json
.netrc
.npmrc
settings.local.json
.claude/settings.local.json

# --- OS and editor noise ---
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
*~
